[Unit]
Description=Stray mp4 Player Service
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
ExecStart=/home/mbutki/pi_projects/python/.venv/bin/python /home/mbutki/pi_projects/python/src/displays/hallway/stray.py /home/mbutki/pi_projects/python/src/displays/hallway/stray 7 0
WorkingDirectory=/home/mbutki/pi_projects/python/src/displays/hallway
User=mbutki
Group=mbutki

# Graceful shutdown settings
TimeoutStopSec=10
KillMode=mixed
KillSignal=SIGTERM

# Restart policy
Restart=always
RestartSec=5

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gif-player

# Security and resource limits
PrivateTmp=true
NoNewPrivileges=true
LimitNOFILE=1024

# Environment
Environment=PYTHONUNBUFFERED=1
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=DISPLAY=:0

[Install]
WantedBy=multi-user.target