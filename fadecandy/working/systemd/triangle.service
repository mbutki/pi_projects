[Unit]
Description=Run Processing sketch for triangle display
Wants=network-online.target fcserver.service
After=network-online.target fcserver.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=mbutki
Environment=DISPLAY=:99
Environment=SKETCH=triangle16_snake
ExecStart=/bin/bash -c "/snap/bin/processing cli --sketch=/home/mbutki/pi_projects/fadecandy/fadecandy-original/examples/processing/${SKETCH} --run"
ExecStop=/usr/bin/pkill -f processing
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
